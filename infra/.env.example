# Скопировать в /opt/goko/.env на VPS и в .env в корне репозитория на ПК. Значения не коммитить.
# У пустых значений комментарий — строкой выше: парсер --env-file в docker compose читает
# «KEY=   # текст» как значение «# текст». После непустого значения хвост с # он отрезает.
WEB_HOST=goko.example.org          # страница и /api; A-запись -> адрес VPS
LK_HOST=goko-lk.example.org        # сигналинг LiveKit и TURN; A-запись -> адрес VPS
# ACME_EMAIL: почта founder'а для Let's Encrypt; пусто -> фиктивный admin@WEB_HOST, письма уйдут в никуда
ACME_EMAIL=
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.6   # проверено 08.09: новейший стабильный тег
# LIVEKIT_API_KEY: openssl rand -hex 8
LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET: openssl rand -hex 32
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://goko-lk.example.org   # = wss://LK_HOST; для воркера и game-server на ПК
# OPENAI_API_KEY: только voice-agent
OPENAI_API_KEY=
# APP_KEY: заголовок X-App-Key для /api/*; openssl rand -hex 16. Один и тот же в .env ПК (вшивается в бандл веба) и в /opt/goko/.env
APP_KEY=
# ENGINE_KEY: заголовок X-Engine-Key между game-server и go-engine
ENGINE_KEY=
API_UPSTREAM=127.0.0.1:8787        # prod: контейнер game-server; dev: <tailscale-ip-ПК>:8787
AGENT_NAME=goko                    # на ПК в dev-режиме: goko-dev
VOICE_MODE=realtime                # pipeline — запасной конвейер STT -> LLM -> TTS (раздел 9 спеки)
API_BASE=http://127.0.0.1:8787     # куда voice-agent ходит за партией; в контейнере http://game-server:8787
# KATAGO_BIN: только на ПК: путь к katago.exe (OpenCL-сборка)
KATAGO_BIN=
# KATAGO_MODEL: путь к основной сети; по умолчанию apps/go-engine/models/kata1-b10c128-...txt.gz
KATAGO_MODEL=
# KATAGO_HUMAN_MODEL: путь к человеческой сети; по умолчанию apps/go-engine/models/b18c384nbt-humanv0.bin.gz
KATAGO_HUMAN_MODEL=
# KATAGO_CONFIG: по умолчанию apps/go-engine/config/analysis.cfg
KATAGO_CONFIG=
ENGINE_PORT=8788                   # go-engine слушает ENGINE_HOST:ENGINE_PORT
ENGINE_HOST=127.0.0.1              # в контейнере 0.0.0.0
ENGINE_URL=http://127.0.0.1:8788   # куда game-server ходит за ходами; в контейнере http://go-engine:8788
# FAKE_ENGINE: 1 — game-server без KataGo (легальные случайные ходы), для тестов и smoke
FAKE_ENGINE=
PORT=8787                          # game-server
HOST=127.0.0.1                     # в контейнере 0.0.0.0; в dev-режиме через Tailscale — адрес tailscale-интерфейса ПК
# DATA_DIR: снапшоты партий; по умолчанию data/games
DATA_DIR=
MAX_SESSIONS=3                     # лимит активных сессий
SESSION_TTL_MS=7200000             # 2 часа без событий — сессия закрывается
# TRUST_PROXY: 1 — game-server за своим прокси (Caddy): лимит частоты по последнему адресу X-Forwarded-For; без прокси пусто, иначе клиент подменит адрес
TRUST_PROXY=
# ALLOW_SESSIONLESS_GAMES: 1 — POST /api/games создаёт партию без сессии, GET /api/games отдаёт список; npm run dev и smoke ставят сами; на VPS пусто (D-0012)
ALLOW_SESSIONLESS_GAMES=
# HETZNER_API: только на ПК, не обязателен: токен API Hetzner (проект goko) для сервера и рескейла агентом
HETZNER_API=
ENGINE_CPUS=1.5                    # лимит CPU контейнера go-engine, чтобы LiveKit и Caddy не голодали во время analyze
KATAGO_ASSET=katago-v1.18.1-eigenavx2-linux-x64.zip   # без AVX2 на VPS: katago-v1.18.1-eigen-linux-x64.zip
# KATAGO_SHA256: при смене KATAGO_ASSET — sha256 скачанного zip этой сборки; пусто — сумма eigenavx2 по умолчанию (args в docker-compose.yml, копия ARG Dockerfile)
KATAGO_SHA256=
